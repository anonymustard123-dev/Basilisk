# Without these three values the app serves four public seeds in read-only mode.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated approved internal users. Create these users in Supabase Auth.
BASILISK_ALLOWED_EMAILS=
# Used by npm run seed only; not a browser variable.
BASILISK_TENANT_ID=
# Optional providers; all keys stay server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional scheduled batch runner; set a long random value in Vercel.
CRON_SECRET=

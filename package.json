{
  "name": "basilisk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-styles.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/prepare-styles.mjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "next": "^15.5.23",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.5.23",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
